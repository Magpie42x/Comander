<UserControl x:Class="Comander.Controls.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Comander.Controls">
    <Border x:Name="RootBorder" Style="{DynamicResource PaneBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- адресная строка -->
            <Border Grid.Row="0" Background="{DynamicResource Panel2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,6">
                    <Border x:Name="TagChip" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" Padding="8,2"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10"
                            Cursor="Hand" ToolTip="Режим панели — нажми, чтобы переключить (F6)">
                        <TextBlock x:Name="TagText" Text="локально" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <Button x:Name="BtnDisconnect" DockPanel.Dock="Right" Content="⏏" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="4,0,0,0" Padding="6,1"
                            Style="{DynamicResource ChromeButtonStyle}" ToolTip="Отключиться от сервера (SFTP)"/>
                    <Button x:Name="BtnMode" DockPanel.Dock="Right" Content="▾" VerticalAlignment="Center"
                            Margin="4,0,0,0" Padding="6,1"
                            Style="{DynamicResource ChromeButtonStyle}" ToolTip="Режим панели: локально / SFTP-профили"/>
                    <Button x:Name="BtnExtFilter" DockPanel.Dock="Right" Content="ext" VerticalAlignment="Center"
                            Margin="4,0,0,0" Padding="7,1" Opacity="0.55"
                            Style="{DynamicResource ChromeButtonStyle}" ToolTip="Фильтр по расширению файлов (F4)"/>
                    <Button x:Name="BtnBack" DockPanel.Dock="Left" Content="◀" VerticalAlignment="Center"
                            Margin="0,0,4,0" Padding="6,1"
                            Style="{DynamicResource ChromeButtonStyle}" ToolTip="Назад (Q)"/>
                    <Button x:Name="BtnFwd" DockPanel.Dock="Left" Content="▶" VerticalAlignment="Center"
                            Margin="0,0,6,0" Padding="6,1"
                            Style="{DynamicResource ChromeButtonStyle}" ToolTip="Вперёд (E)"/>
                    <TextBox x:Name="PathBox" FontFamily="Consolas" IsReadOnly="False"/>
                </DockPanel>
            </Border>

            <!-- строка фильтра (F3) -->
            <Border x:Name="FilterRow" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource Panel2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,5">
                    <TextBlock Text="Фильтр:" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="FilterBox"/>
                </DockPanel>
            </Border>

            <!-- список файлов -->
            <ListView x:Name="List" Grid.Row="2" SelectionMode="Single"
                      controls:GridViewResize.ClampToViewport="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" Width="340">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource MarkedEdgeBrush}"
                                                   Visibility="{Binding IsMarked, Converter={StaticResource BoolToVis}}"/>
                                        <Border Width="19" Height="19" CornerRadius="4" Margin="0,0,8,0"
                                                Background="{Binding IconBg}">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="{Binding IconFont}"
                                                       FontSize="{Binding IconSize}"
                                                       FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Тип" Width="90" DisplayMemberBinding="{Binding TypeName}"
                                       />
                        <GridViewColumn Header="Размер" Width="90"
                                       >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Изменён" Width="130"
                                       >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedText}" TextAlignment="Right"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- меню фильтра по расширению (F4): поиск по расширениям текущей папки -->
            <Popup x:Name="ExtPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnExtFilter}"
                   StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Width="270">
                    <StackPanel>
                        <TextBox x:Name="ExtSearch" ToolTip="Введи расширение, Enter — применить"/>
                        <ListBox x:Name="ExtList" MaxHeight="320" Margin="0,6,0,0"
                                 Background="{DynamicResource Panel2Brush}"
                                 Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MarkedBgBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
