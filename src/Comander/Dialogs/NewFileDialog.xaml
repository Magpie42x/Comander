<Window x:Class="Comander.Dialogs.NewFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comander — новый файл" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Padding="16">
        <StackPanel>
            <TextBlock Text="Имя нового файла — слева от точки имя, справа расширение:"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="ValueBox" Margin="0,0,0,10">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="имя.расширение" Margin="10,3,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="Популярные типы — фильтруются по расширению после точки:"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <ListBox x:Name="PresetList" Height="200" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" Padding="14,5"
                        Style="{DynamicResource ChromeButtonStyle}"/>
                <Button Content="Создать" IsDefault="True" Padding="18,5" Click="OnOk"
                        Style="{DynamicResource ChromeButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
