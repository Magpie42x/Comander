<Window x:Class="Comander.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comander — настройки" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- в тёмных темах текст радиокнопок и чекбоксов по умолчанию чёрный — красим явно -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>
    <Border Padding="18">
        <StackPanel>
            <TextBlock Text="⚙ Настройки" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Шрифт интерфейса:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <StackPanel x:Name="FontList" Margin="6,0,0,12"/>

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Размер шрифта (8–20):" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="SizeBox" Width="60" HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock Text="Терминал по умолчанию (Ctrl+`):" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <StackPanel x:Name="ShellList" Margin="6,0,0,12"/>

            <TextBlock Text="Шелл на удалённой машине (терминал по SSH):" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <StackPanel x:Name="RemoteShellList" Margin="6,0,0,12"/>

            <TextBlock Text="Сохранённые SFTP-подключения:" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <DockPanel Margin="6,0,0,12">
                <Button Content="Удалить выбранное" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                        Style="{DynamicResource ChromeButtonStyle}" Padding="8,3" FontSize="11"
                        Margin="8,0,0,0" Click="OnDeleteProfile"/>
                <ListBox x:Name="ProfilesList" Height="64"/>
            </DockPanel>

            <CheckBox x:Name="AutoStartBox" Content="Запускать Comander при входе в Windows" Margin="0,0,0,12"/>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"
                       Text="Глобальный вызов окна из любого места Windows: Ctrl+Alt+C (повторное нажатие сворачивает). Свернуть внутри приложения: Ctrl+M. Закрепить папку/файл в корне быстрого доступа: Ctrl+P."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" Padding="14,5"
                        Style="{DynamicResource ChromeButtonStyle}"/>
                <Button Content="OK" IsDefault="True" Padding="18,5" Click="OnOk"
                        Style="{DynamicResource ChromeButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
