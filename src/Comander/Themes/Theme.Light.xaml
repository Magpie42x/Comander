<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Light: палитра утверждена (ТЗ 9.2), фон приглушен к серому по просьбе пользователя -->
    <SolidColorBrush x:Key="BgBrush" Color="#F1F0E8"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#E5E3D6"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="PanelGhostBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="PanelSoloBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#B3F4F3EB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#22261F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7060"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6F7850"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="#B66B3B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DAD7C8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0D22261F"/>
    <SolidColorBrush x:Key="CursorRingBrush" Color="#6F7850"/>
    <SolidColorBrush x:Key="MarkedBgBrush" Color="#246F7850"/>
    <SolidColorBrush x:Key="MarkedEdgeBrush" Color="#6F7850"/>

    <Color x:Key="GlowColor">#1422261F</Color>
    <sys:Double x:Key="GlowBlur">4</sys:Double>
    <sys:Double x:Key="GlowDepth">1</sys:Double>
    <sys:Double x:Key="BgArtOpacity">0.30</sys:Double>
    <sys:Double x:Key="InactiveDimOpacity">0.45</sys:Double>
</ResourceDictionary>
