<Window x:Class="Comander.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comander — справка" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="◆ Comander — клавиатурная схема" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock x:Name="KeysText" TextWrapping="Wrap" LineHeight="24"/>
                <TextBlock Text="Esc — закрыть это окно. Клавиши W/S/Q/E привязаны к физическим позициям и работают в русской раскладке."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
